# Exact frontend origins, separated by commas. Replace with your Vercel/custom domain in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
# Optional AI research; leave both empty for local search only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HOST=0.0.0.0
PORT=8000
TERRATWIN_AI_OUTPUTS_DIR=research/outputs
# Optional legacy pipeline API: these files are not bundled with this repository.
TERRATWIN_OUTPUTS_DIR=outputs
TERRATWIN_PROVENANCE_PATH=provenance.json

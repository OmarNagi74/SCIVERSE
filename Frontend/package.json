{
  "name": "sciverse-frontend",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "build:lunar-texture": "python3 scripts/mask_moon_coverage.py",
    "validate:lunar-texture": "python3 scripts/mask_moon_coverage.py --validate-only",
    "build:planet-visuals": "python3 scripts/prepare_planet_visuals.py",
    "build:tycho-terrain": "python3 scripts/build_tycho_terrain.py",
    "validate:tycho-terrain": "python3 scripts/build_tycho_terrain.py --validate-only",
    "test:terrain-pipeline": "python3 scripts/test_tycho_terrain.py",
    "dev:frontend": "vite --host 0.0.0.0 --port 3000",
    "build:frontend": "vite build",
    "dev:backend": "bash scripts/run-backend.sh",
    "dev:all": "bash scripts/run-local.sh",
    "test:e2e": "node --test tests/live-e2e.test.mjs",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "cesium": "^1.146.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.187.0",
    "vite-plugin-cesium": "^1.2.23"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
